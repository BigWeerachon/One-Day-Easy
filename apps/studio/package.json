{
  "name": "studio",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "test": "node --test --experimental-strip-types lib/*.test.ts",
    "db:setup": "node --env-file-if-exists=.env.local scripts/db-setup.mjs",
    "db:seed": "node --env-file-if-exists=.env.local scripts/db-setup.mjs --seed",
    "db:reset": "node --env-file-if-exists=.env.local scripts/db-setup.mjs --reset --seed",
    "user:create": "node --env-file-if-exists=.env.local --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/create-user.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@ode/blocks": "*",
    "next": "^16.0.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.6.0"
  }
}
