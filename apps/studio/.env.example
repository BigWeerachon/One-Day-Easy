# Supabase → Project Settings → Database → Connection string → URI
# แนะนำ Session pooler (port 5432) สำหรับ server ที่รันนาน · Transaction pooler (6543) สำหรับ Vercel serverless
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# LINE Messaging API (LINE Developers → channel → Basic settings / Messaging API)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# ป้องกัน /api/cron/line · Vercel Cron ส่ง Authorization: Bearer $CRON_SECRET ให้อัตโนมัติ
CRON_SECRET=

# Claude API (console.anthropic.com → API keys)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# ตรวจสลิปอัตโนมัติ · บัญชีที่ลูกค้าต้องโอนเข้า (คั่นด้วย ,) — ถ้าไม่ตั้ง จะไม่อนุมัติอัตโนมัติ
SHOP_RECEIVER_NAMES=บจก. วันเดย์ อีซี่
SHOP_RECEIVER_ACCOUNTS=123-4-56789-0,0812345678
# off (ค่าเริ่มต้น) = ระบบอ่านและตรวจให้ แต่คนกดยืนยันทุกใบ · on = อนุมัติเองเมื่อผ่านทุกกฎ
SLIP_AUTO_APPROVE=off
SLIP_MAX_AGE_DAYS=3

# Portal ฝั่งลูกค้า
STUDIO_URL=https://studio.example.com      # ใช้สร้างลิงก์ /p/<token> ที่ส่งให้ลูกค้า
PROMPTPAY_ID=0812345678                    # เบอร์/เลข 13 หลักสำหรับ QR พร้อมเพย์

# Site Engine (apps/engine)
ENGINE_URL=https://engine.example.com   # ใช้สร้างลิงก์ดูตัวอย่างเว็บร่าง
PREVIEW_SECRET=                         # สุ่มยาวๆ · ต้องตรงกับ Engine

# ข้อมูลผู้ออกเอกสาร (หัว PDF ใบแจ้งหนี้/ใบเสร็จ)
SELLER_NAME=บริษัท วันเดย์ อีซี่ จำกัด
SELLER_ADDRESS=
SELLER_TAX_ID=
SELLER_PHONE=
# SELLER_VAT_REGISTERED=1   # เมื่อจด VAT แล้ว (แสดงแยกภาษี 7%)

# โดเมน + SSL (Vercel) · token: vercel.com/account/tokens
VERCEL_TOKEN=
VERCEL_TEAM_ID=
ENGINE_PROJECT_ID=                # id หรือชื่อโปรเจกต์ Site Engine
PLATFORM_DOMAIN=onedayeasy.app
DOMAIN_MAX_PRICE_USD=30           # เพดานราคาต่อโดเมน (ซื้อได้เฉพาะ Owner)
# ผู้จดโดเมน (ใช้ข้อมูลบริษัท)
REGISTRANT_FIRST_NAME=
REGISTRANT_LAST_NAME=
REGISTRANT_COMPANY=
REGISTRANT_EMAIL=
REGISTRANT_PHONE=
REGISTRANT_ADDRESS=
REGISTRANT_CITY=Bangkok
REGISTRANT_STATE=Bangkok
REGISTRANT_ZIP=
REGISTRANT_COUNTRY=TH

# อีเมลแจ้งเตือน (Resend · resend.com → API Keys · ต้องยืนยันโดเมนผู้ส่งใน Resend ก่อน)
RESEND_API_KEY=
EMAIL_FROM=Studio <noti@yourdomain.com>
# EMAIL_REPLY_TO=team@yourdomain.com
