# Supabase → Project Settings → Database → Connection string → URI
# แนะนำ Session pooler (port 5432) สำหรับ server ที่รันนาน · Transaction pooler (6543) สำหรับ Vercel serverless
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# LINE Messaging API (LINE Developers → channel → Basic settings / Messaging API)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# ป้องกัน /api/cron/line · Vercel Cron ส่ง Authorization: Bearer $CRON_SECRET ให้อัตโนมัติ
CRON_SECRET=

# Claude API (console.anthropic.com → API keys)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# ตรวจสลิปอัตโนมัติ · บัญชีที่ลูกค้าต้องโอนเข้า (คั่นด้วย ,) — ถ้าไม่ตั้ง จะไม่อนุมัติอัตโนมัติ
SHOP_RECEIVER_NAMES=บจก. วันเดย์ อีซี่
SHOP_RECEIVER_ACCOUNTS=123-4-56789-0,0812345678
# on (ค่าเริ่มต้น) = อนุมัติเองเมื่อผ่านทุกกฎ · off = อ่านและตรวจให้ แต่คนกดยืนยันทุกใบ
SLIP_AUTO_APPROVE=on
SLIP_MAX_AGE_DAYS=3
